# ==============================================================================
# Environment Configuration - Smart Home CCTV Stack (Dokploy / M70q Homelab)
# ==============================================================================

# RTSP Camera Authentication (Reolink / Tapo Local User)
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=ChangeMeStrongPassword123!
CAMERA_FRONT_IP=192.168.1.101
CAMERA_CARPORT_IP=192.168.1.102

# Telegram Bot Gateway
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Feature Toggles
ENABLE_AUDIO_MODULE=false
DEBUG_MODE=false

# Persistent Storage Path on Dokploy Host (Lenovo ThinkCentre M70q)
DATA_STORAGE_PATH=/home/usereal/apps/development/smart-home-cctv/data

# Secret Keys
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=ChangeMeAdminPassword123!
JWT_SECRET=supersecretjwtauthkeyforhomelabdashboard
